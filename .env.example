# ==============================================================================
# AirAware AI — Environment Variables Template (.env.example)
# ==============================================================================

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API Key (Set on Supabase Edge Function: supabase secrets set GEMINI_API_KEY=...)
GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_API_KEY=your-gemini-api-key

# WAQI (World Air Quality Index) Token (https://aqicn.org/data-platform/token/)
VITE_WAQI_API_TOKEN=demo

# Data.gov.in Configuration (Optional India CPCB data portal)
VITE_DATA_GOV_IN_API_KEY=your-data-gov-in-key
VITE_DATA_GOV_IN_BASE_URL=https://api.data.gov.in/resource
VITE_DATA_GOV_IN_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
